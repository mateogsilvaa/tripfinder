# --- Metodo por defecto: SMTP con Gmail -----------------------------------
# Hace falta una CONTRASENA DE APLICACION, no la de entrar a Gmail:
#   Cuenta de Google -> Seguridad -> Verificacion en 2 pasos (encendida)
#   -> Contrasenas de aplicacion -> crear
# Son 16 caracteres que Google ensena en cuatro grupos de cuatro. Da igual si
# copias los espacios: el codigo los quita.
#
# HOST y PORT solo si quieres otra cosa: van a smtp.gmail.com y 465. Con 465 se
# habla TLS desde el saludo; con 587, STARTTLS. Las dos valen.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mateogonsilva@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_TO=mateogonsilva@gmail.com

# --- Alternativa: Resend (https://resend.com) -----------------------------
# OJO: mientras no verifiques un dominio, Resend SOLO escribe a la direccion
# del dueno de la clave. El dominio de esta web es mateogsilvaa.github.io y
# github.io es de GitHub, asi que esa verificacion no se puede hacer: con
# Resend solo recibe avisos una cuenta y las demas acaban en una issue.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Opcional. Sin dominio propio usa el remitente de pruebas onboarding@resend.dev
RESEND_FROM=TripFinder <onboarding@resend.dev>

# Opcional: https://developers.amadeus.com (plan gratuito)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Usado en los enlaces de los emails
SITE_URL=https://mateogsilvaa.github.io/tripfinder
REPO_SLUG=mateogsilvaa/tripfinder
