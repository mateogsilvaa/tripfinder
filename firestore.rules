rules_version = '2';

/* Quien puede leer y escribir qué en la base de datos.

   Esto es lo único que separa los datos de cada persona, porque el repo y la
   web son públicos y la clave de la API de Firebase va en el HTML a la vista de
   todos. La clave no es un secreto: abre la puerta, y estas reglas deciden qué
   hay detrás. Por eso se prueban contra el emulador en CI (tests/firebase).

   Lo que no aparece aquí está PROHIBIDO para el navegador. Lo que escriben los
   scrapers y los workflows entra con la cuenta de servicio, que se salta estas
   reglas, así que no hace falta abrirles nada.

     usuarios/{uid}        la ficha de cada cuenta: nombre, correo, estado
     cuentas_antiguas/{id} las cuentas de antes de Firebase (solo el administrador)
     encargos/{id}         lo que se le pide a un scraper (la cola)

   La web está abierta a todo el mundo: una cuenta recién registrada nace
   `aprobado` y con `plan: gratis`. El plan premium existe —lo da el
   administrador y la web lo enseña— pero TODAVÍA NO SE EXIGE: de momento
   cualquier cuenta aprobada lanza búsquedas. Para exigirlo, el `create` de
   `encargos` pasa de `aprobado()` a `premium()`, y en `nube.py` y `nube.js`
   se enciende PREMIUM_OBLIGATORIO.

   Las cuentas de antes de abrir la web no tienen `plan`, y una aprobada sin
   `plan` es premium: son las de los conocidos, y no hace falta migrarlas. */
service cloud.firestore {
  match /databases/{database}/documents {

    function entra() {
      return request.auth != null;
    }

    function ficha(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function aprobado() {
      return entra()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && ficha(request.auth.uid).estado == 'aprobado';
    }

    // El administrador es una cuenta aprobada con `admin: true`. Ese campo solo
    // se pone con la cuenta de servicio (`tripfinder nube-admin`): ninguna
    // regla de abajo deja escribirlo desde el navegador.
    // Premium: aprobada y con `plan: premium`, o aprobada de antes de que
    // existieran los planes (sin el campo). Las nuevas nacen con `plan: gratis`
    // y ninguna regla deja a nadie cambiarse el suyo.
    function premium() {
      return aprobado() && ficha(request.auth.uid).get('plan', 'premium') == 'premium';
    }

    function admin() {
      return aprobado() && ficha(request.auth.uid).get('admin', false) == true;
    }

    match /usuarios/{uid} {
      allow get: if entra() && (request.auth.uid == uid || admin());
      allow list: if admin();

      // Registrarse. La ficha nace `aprobado` y `gratis`, a nombre del correo
      // con el que se ha entrado, y sin `admin`: nadie se da permisos al
      // crearla. `pendiente` sin plan es lo que manda una web de antes que siga
      // en la caché de algún navegador; `tripfinder encargos` la abre a gratis.
      allow create: if entra()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'estado', 'plan', 'creado', 'prefs'])
        && request.resource.data.keys().hasAll(['nombre', 'correo', 'estado', 'creado'])
        && ((request.resource.data.estado == 'aprobado' && request.resource.data.get('plan', '') == 'gratis')
          || (request.resource.data.estado == 'pendiente' && !('plan' in request.resource.data)))
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.creado == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40;

      allow update: if entra() && (
        // Cada cual, su nombre, sus preferencias y si su correo está verificado.
        // Ni el estado ni el correo ni a qué cuenta antigua está vinculado. Lo de
        // `verificado` no se cree: tiene que ser EXACTAMENTE lo que dice el token
        // que firma Firebase, y solo Firebase sabe si ese correo es de verdad suyo.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'prefs', 'verificado'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 40
          && (!('verificado' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.verificado == request.auth.token.email_verified))
        // El administrador, las de las demás. No la suya propia, para no dejar la
        // web sin nadie al mando por un clic.
        || (admin()
          && request.auth.uid != uid
          && (
            // Aprobar, bloquear o devolver a pendiente, y dar o quitar premium.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'plan'])
              && request.resource.data.estado in ['pendiente', 'aprobado', 'bloqueado']
              && request.resource.data.get('plan', 'premium') in ['gratis', 'premium'])
            // Vincularla con una cuenta de antes: hereda sus avisos, sus
            // seguimientos y sus búsquedas. Solo si ha verificado su correo, porque
            // si no, bastaría registrarse con el correo de otro para quedarse con
            // lo suyo, y solo una vez.
            // Quien tenía cuenta de antes era un conocido: se le da premium.
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'legado', 'prefs', 'plan'])
              && 'legado' in request.resource.data.diff(resource.data).affectedKeys()
              && resource.data.get('verificado', false) == true
              && resource.data.get('legado', null) == null
              && request.resource.data.estado in ['pendiente', 'aprobado', 'bloqueado']
              && request.resource.data.get('plan', 'premium') in ['gratis', 'premium']
              && exists(/databases/$(database)/documents/cuentas_antiguas/$(request.resource.data.legado))
              && get(/databases/$(database)/documents/cuentas_antiguas/$(request.resource.data.legado)).data.get('vinculada', null) == null)
          ))
      );
    }

    // Las cuentas de antes de Firebase, copiadas con `tripfinder migrar-cuentas`:
    // nombre, correo y avisos. Nunca contraseñas ni sobres ni el token. Solo las ve
    // el administrador, y solo puede marcar a cuál cuenta nueva se ha vinculado
    // cada una; el resto lo escribe la cuenta de servicio.
    match /cuentas_antiguas/{id} {
      allow get, list: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vinculada'])
        && request.resource.data.vinculada is string;
    }

    // Lo que acaba de encontrar un scraper, para que la web lo vea sin esperar
    // al despliegue de Pages. Es lo mismo que se publica en `data/` —la web es
    // pública—, así que se lee sin cuenta. Por id, nunca la lista entera, y
    // solo lo escribe la cuenta de servicio.
    match /resultados/{id} {
      allow get: if true;
    }

    match /encargos/{id} {
      // Pedir algo a un scraper: cuentas aprobadas (premium cuando se exija,
      // ver arriba), a su nombre, y con las mismas diez propiedades como mucho
      // que admite GitHub en un dispatch.
      allow create: if aprobado()
        && request.resource.data.keys().hasOnly(['tipo', 'owner', 'payload', 'estado', 'creado'])
        && request.resource.data.keys().hasAll(['tipo', 'owner', 'payload', 'estado', 'creado'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.tipo in ['search', 'stay', 'interrail', 'watch', 'unwatch', 'delete_search']
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 10;

      // Ver cómo van los tuyos. Las consultas tienen que filtrar por `owner`.
      allow get, list: if entra() && (resource.data.owner == request.auth.uid || admin());
    }
  }
}
