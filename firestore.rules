rules_version = '2';

/* Quien puede leer y escribir qué en la base de datos.

   Esto es lo único que separa los datos de cada persona, porque el repo y la
   web son públicos y la clave de la API de Firebase va en el HTML a la vista de
   todos. La clave no es un secreto: abre la puerta, y estas reglas deciden qué
   hay detrás. Por eso se prueban contra el emulador en CI (tests/firebase).

   Lo que no aparece aquí está PROHIBIDO para el navegador. Lo que escriben los
   scrapers y los workflows entra con la cuenta de servicio, que se salta estas
   reglas, así que no hace falta abrirles nada.

     usuarios/{uid}        la ficha de cada cuenta: nombre, correo, estado
     cuentas_antiguas/{id} las cuentas de antes de Firebase (solo el administrador)
     encargos/{id}         lo que se le pide a un scraper (la cola)
     actividad/{id}        entradas, errores y tiempo por pantalla (solo lo lee
                           el administrador)
     hops/{id}             los grupos de viaje: propuestas, votos y chat
     hop_slots/{uid}       el HOP activo de una cuenta premium (uno a la vez)

   La web está abierta a todo el mundo: una cuenta recién registrada nace
   `aprobado` y con `plan: gratis`. El plan premium existe —lo da el
   administrador y la web lo enseña— pero TODAVÍA NO SE EXIGE: de momento
   cualquier cuenta aprobada lanza búsquedas. Para exigirlo, el `create` de
   `encargos` pasa de `aprobado()` a `premium()`, y en `nube.py` y `nube.js`
   se enciende PREMIUM_OBLIGATORIO.

   Las cuentas de antes de abrir la web no tienen `plan`, y una aprobada sin
   `plan` es premium: son las de los conocidos, y no hace falta migrarlas. */
service cloud.firestore {
  match /databases/{database}/documents {

    function entra() {
      return request.auth != null;
    }

    function ficha(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function aprobado() {
      return entra()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && ficha(request.auth.uid).estado == 'aprobado';
    }

    // El administrador es una cuenta aprobada con `admin: true`. Ese campo solo
    // se pone con la cuenta de servicio (`tripfinder nube-admin`): ninguna
    // regla de abajo deja escribirlo desde el navegador.
    // Premium: aprobada y con `plan: premium`, o aprobada de antes de que
    // existieran los planes (sin el campo). Las nuevas nacen con `plan: gratis`
    // y ninguna regla deja a nadie cambiarse el suyo.
    // Max es premium sin límites: lo mismo y, además, tantas HOP como quiera.
    // Quien administra la web tiene Max sin tener que ponérselo: su propia ficha
    // no la puede tocar nadie desde el navegador, ni él.
    function premium() {
      return aprobado() && (ficha(request.auth.uid).get('plan', 'premium') in ['premium', 'max']
        || ficha(request.auth.uid).get('admin', false) == true);
    }

    function max() {
      return aprobado() && (ficha(request.auth.uid).get('plan', 'premium') == 'max'
        || ficha(request.auth.uid).get('admin', false) == true);
    }

    function admin() {
      return aprobado() && ficha(request.auth.uid).get('admin', false) == true;
    }

    match /usuarios/{uid} {
      allow get: if entra() && (request.auth.uid == uid || admin());
      allow list: if admin();

      // Registrarse. La ficha nace `aprobado` y `gratis`, a nombre del correo
      // con el que se ha entrado, y sin `admin`: nadie se da permisos al
      // crearla. `pendiente` sin plan es lo que manda una web de antes que siga
      // en la caché de algún navegador; `tripfinder encargos` la abre a gratis.
      allow create: if entra()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'estado', 'plan', 'creado', 'prefs'])
        && request.resource.data.keys().hasAll(['nombre', 'correo', 'estado', 'creado'])
        && ((request.resource.data.estado == 'aprobado' && request.resource.data.get('plan', '') == 'gratis')
          || (request.resource.data.estado == 'pendiente' && !('plan' in request.resource.data)))
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.creado == request.time
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40;

      allow update: if entra() && (
        // Cada cual, su nombre, sus preferencias y si su correo está verificado.
        // Ni el estado ni el correo ni a qué cuenta antigua está vinculado. Lo de
        // `verificado` no se cree: tiene que ser EXACTAMENTE lo que dice el token
        // que firma Firebase, y solo Firebase sabe si ese correo es de verdad suyo.
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'prefs', 'verificado'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 40
          && (!('verificado' in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.verificado == request.auth.token.email_verified))
        // El administrador, las de las demás. No la suya propia, para no dejar la
        // web sin nadie al mando por un clic.
        || (admin()
          && request.auth.uid != uid
          && (
            // Aprobar, bloquear o devolver a pendiente, y dar o quitar premium.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'plan'])
              && request.resource.data.estado in ['pendiente', 'aprobado', 'bloqueado']
              && request.resource.data.get('plan', 'premium') in ['gratis', 'premium', 'max'])
          ))
      );
    }

    // Las cuentas de antes de Firebase, copiadas con `tripfinder migrar-cuentas`.
    // Ya no se vinculan (quien no migró a tiempo entra como nueva): las ve el
    // administrador y nada más. Las que se vincularon siguen con su `legado`.
    match /cuentas_antiguas/{id} {
      allow get, list: if admin();
    }

    // Lo que acaba de encontrar un scraper, para que la web lo vea sin esperar
    // al despliegue de Pages. Es lo mismo que se publica en `data/` —la web es
    // pública—, así que se lee sin cuenta. Por id, nunca la lista entera, y
    // solo lo escribe la cuenta de servicio.
    match /resultados/{id} {
      allow get: if true;
    }

    // Cómo se usa la web, para el panel: quién entra (`entrada`), qué falla
    // (`error`) y cuánto se está en cada pantalla (`pantalla`). Se escribe
    // también sin cuenta —el tiempo y los errores de quien solo mira—, pero sin
    // `uid`; con `uid`, solo el tuyo. Nada se cambia ni se borra después: caduca
    // solo (`caduca`, política TTL) y solo lo lee el administrador.
    match /actividad/{id} {
      function d() {
        return request.resource.data;
      }
      allow create: if d().keys().hasOnly(['tipo', 'uid', 'pantalla', 'segundos', 'visitas', 'metodo',
            'mensaje', 'detalle', 'navegador', 'creado', 'caduca'])
        && d().keys().hasAll(['tipo', 'uid', 'pantalla', 'creado', 'caduca'])
        && (d().tipo == 'entrada' || d().tipo == 'error' || d().tipo == 'pantalla')
        && d().creado == request.time
        && d().caduca is timestamp
        && d().caduca < request.time + duration.value(100, 'd')
        && d().pantalla is string && d().pantalla.size() <= 60
        && (d().uid == null || (entra() && d().uid == request.auth.uid))
        && (d().tipo != 'entrada' || (entra() && d().uid == request.auth.uid))
        && (!('segundos' in d()) || (d().segundos is int && d().segundos >= 0 && d().segundos <= 86400))
        && (!('visitas' in d()) || (d().visitas is int && d().visitas >= 0 && d().visitas <= 1000))
        && (!('metodo' in d()) || (d().metodo is string && d().metodo.size() <= 20))
        && (!('mensaje' in d()) || (d().mensaje is string && d().mensaje.size() <= 300))
        && (!('detalle' in d()) || (d().detalle is string && d().detalle.size() <= 500))
        && (!('navegador' in d()) || (d().navegador is string && d().navegador.size() <= 160));
      allow get, list: if admin();
    }

    // EL MODO HOP: un grupo para decidir un viaje entre varios. Se proponen
    // fechas y viajes, cada cual vota, y se discute en el chat.
    //
    // · Crearla es premium; unirse, de cualquier cuenta. La invitación es el id
    //   de el HOP: quien lo tiene puede verla y entrar, como un enlace de grupo.
    // · Premium tiene UNA activa a la vez; Max, las que quiera. Las reglas no
    //   saben contar, así que la de premium se ata a `hop_slots/{uid}`: se crea
    //   en la misma escritura que el HOP y, como es un documento por cuenta, no
    //   puede haber dos. Se suelta al borrar el HOP.
    // · Todo lo de dentro lo leen y escriben solo sus miembros.
    // · Cuando pasa la fecha (`caduca`), `tripfinder hops-limpiar` la borra
    //   entera, con sus propuestas y su chat.
    function hop(id) {
      return get(/databases/$(database)/documents/hops/$(id)).data;
    }

    function miembro(id) {
      return entra() && request.auth.uid in hop(id).miembros;
    }

    function esFecha(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Una búsqueda en marcha dentro de un HOP: qué se buscó, quién y cuándo.
    function enMarcha(m) {
      return m == null || (m is map
        && m.keys().hasOnly(['clave', 'texto', 'por', 'nombre', 'lanzada', 'oferta', 'estado', 'n'])
        && (!('clave' in m) || (m.clave is string && m.clave.matches('^[a-z0-9-]{1,80}$')))
        && (!('texto' in m) || (m.texto is string && m.texto.size() <= 200))
        && (!('oferta' in m) || (m.oferta is string && m.oferta.size() <= 120))
        && (!('nombre' in m) || (m.nombre is string && m.nombre.size() <= 40))
        && (!('estado' in m) || m.estado in ['buscando', 'lista', 'vacia']));
    }

    // Las fases del HOP. Las fechas que se fijan (fase 1) y el plan del
    // ganador, que se puede retocar (fase 5).
    function fechasOk(m) {
      return m == null || (m is map && m.keys().hasOnly(['ida', 'vuelta'])
        && (!('ida' in m) || esFecha(m.ida)) && (!('vuelta' in m) || esFecha(m.vuelta)));
    }
    function textoOk(m, k, n) {
      return !(k in m) || (m[k] is string && m[k].size() <= n);
    }
    function enlaceOk(m, k) {
      return !(k in m) || (m[k] is string && m[k].size() <= 500 && (m[k] == '' || m[k].matches('^https://.+')));
    }
    function planOk(m) {
      return m == null || (m is map
        && m.keys().hasOnly(['de', 'titulo', 'pais', 'iata', 'ida', 'vuelta', 'precio', 'compania', 'url',
              'cama', 'cama_url', 'cama_precio', 'nota', 'por', 'nombre'])
        && textoOk(m, 'de', 120) && textoOk(m, 'titulo', 80) && textoOk(m, 'pais', 60) && textoOk(m, 'iata', 8)
        && textoOk(m, 'compania', 60) && textoOk(m, 'cama', 120) && textoOk(m, 'nota', 500)
        && textoOk(m, 'nombre', 40) && textoOk(m, 'por', 128)
        && (!('ida' in m) || m.ida == '' || esFecha(m.ida))
        && (!('vuelta' in m) || m.vuelta == '' || esFecha(m.vuelta))
        && (!('precio' in m) || (m.precio is number && m.precio >= 0 && m.precio <= 100000))
        && (!('cama_precio' in m) || (m.cama_precio is number && m.cama_precio >= 0 && m.cama_precio <= 100000))
        && enlaceOk(m, 'url') && enlaceOk(m, 'cama_url'));
    }
    // Lo que no quiere cada cual: hasta tres ciudades, y cada uno toca solo
    // las suyas.
    function vetoOk(v) {
      return v is list && v.size() <= 3
        && (v.size() < 1 || (v[0] is string && v[0].size() <= 80))
        && (v.size() < 2 || (v[1] is string && v[1].size() <= 80))
        && (v.size() < 3 || (v[2] is string && v[2].size() <= 80));
    }

    match /hops/{hopId} {
      function j() {
        return request.resource.data;
      }
      function datosOk() {
        return j().nombre is string && j().nombre.size() > 0 && j().nombre.size() <= 60
          && esFecha(j().fin)
          && j().caduca is timestamp
          && j().caduca > request.time
          && j().caduca < request.time + duration.value(400, 'd')
          && (!('descripcion' in j()) || (j().descripcion is string && j().descripcion.size() <= 300));
      }

      // Leer un HOP: cualquiera con su id, también sin cuenta. El id es el
      // enlace de invitación (20 letras al azar): quien lo tiene ya podría
      // unirse. Listarlos, solo los tuyos.
      allow get: if true;
      allow list: if entra() && request.auth.uid in resource.data.miembros;

      allow create: if premium()
        && j().keys().hasOnly(['nombre', 'descripcion', 'creador', 'miembros', 'nombres', 'fin', 'caduca', 'creado'])
        && j().keys().hasAll(['nombre', 'creador', 'miembros', 'nombres', 'fin', 'caduca', 'creado'])
        && j().creador == request.auth.uid
        && j().miembros == [request.auth.uid]
        && j().nombres.keys().hasOnly([request.auth.uid])
        && j().nombres[request.auth.uid] is string
        && j().nombres[request.auth.uid].size() <= 40
        && j().creado == request.time
        && datosOk()
        && (max() || getAfter(/databases/$(database)/documents/hop_slots/$(request.auth.uid)).data.hop == hopId);

      allow update: if entra() && (
        // Quien la creó cambia el nombre, la descripción y la fecha.
        (request.auth.uid == resource.data.creador
          && j().diff(resource.data).affectedKeys().hasOnly(['nombre', 'descripcion', 'fin', 'caduca'])
          && datosOk())
        // Unirse: añadirse a uno mismo, y nada más. Hasta 30 por HOP.
        || (aprobado()
          && j().diff(resource.data).affectedKeys().hasOnly(['miembros', 'nombres'])
          && !(request.auth.uid in resource.data.miembros)
          && request.auth.uid in j().miembros
          && j().miembros.hasAll(resource.data.miembros)
          && j().miembros.size() == resource.data.miembros.size() + 1
          && j().miembros.size() <= 30
          && j().nombres.diff(resource.data.nombres).affectedKeys().hasOnly([request.auth.uid])
          && j().nombres[request.auth.uid] is string
          && j().nombres[request.auth.uid].size() <= 40)
        // Lo que el grupo tiene en marcha: la búsqueda de vuelos y la de cama.
        // Cualquier miembro la lanza y la apunta aquí para que la vean todos.
        || (request.auth.uid in resource.data.miembros
          && j().diff(resource.data).affectedKeys().hasOnly(['busqueda', 'cama'])
          && enMarcha(j().get('busqueda', null))
          && enMarcha(j().get('cama', null)))
        // Las fases: cualquier miembro pasa de una a otra, fija las fechas y
        // retoca el plan del ganador.
        || (request.auth.uid in resource.data.miembros
          && j().diff(resource.data).affectedKeys().hasOnly(['fase', 'fechas', 'plan'])
          && (!('fase' in j()) || (j().fase is int && j().fase >= 1 && j().fase <= 5))
          && fechasOk(j().get('fechas', null))
          && planOk(j().get('plan', null)))
        // Los vetos: cada cual los suyos, hasta tres.
        || (request.auth.uid in resource.data.miembros
          && j().diff(resource.data).affectedKeys().hasOnly(['vetos'])
          && j().vetos is map
          && j().vetos.diff(resource.data.get('vetos', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in j().vetos) || vetoOk(j().vetos[request.auth.uid])))
        // Salirse: quitarse a uno mismo. Quien la creó no se sale: la borra.
        || (request.auth.uid in resource.data.miembros
          && request.auth.uid != resource.data.creador
          && j().diff(resource.data).affectedKeys().hasOnly(['miembros', 'nombres'])
          && !(request.auth.uid in j().miembros)
          && resource.data.miembros.hasAll(j().miembros)
          && j().miembros.size() == resource.data.miembros.size() - 1
          && j().nombres.diff(resource.data.nombres).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if entra() && request.auth.uid == resource.data.creador;

      match /propuestas/{pid} {
        function p() {
          return request.resource.data;
        }
        // Las propuestas se ven con el enlace, como el HOP; el chat, no.
        allow read: if true;
        allow create: if miembro(hopId)
          && p().keys().hasOnly(['tipo', 'titulo', 'nota', 'destino', 'ida', 'vuelta', 'precio', 'url', 'autor', 'nombre', 'votos', 'creado',
                'compania', 'horario', 'oferta', 'iata', 'pais', 'foto', 'origen', 'cama', 'cama_url', 'cama_precio'])
          && p().keys().hasAll(['tipo', 'titulo', 'autor', 'votos', 'creado'])
          && (p().tipo == 'fechas' || p().tipo == 'viaje' || p().tipo == 'vuelo' || p().tipo == 'cama')
          && p().autor == request.auth.uid
          && p().votos == {}
          && p().creado == request.time
          && p().titulo is string && p().titulo.size() > 0 && p().titulo.size() <= 80
          && (!('nota' in p()) || (p().nota is string && p().nota.size() <= 500))
          && (!('destino' in p()) || (p().destino is string && p().destino.size() <= 80))
          && (!('ida' in p()) || esFecha(p().ida))
          && (!('vuelta' in p()) || esFecha(p().vuelta))
          && (!('precio' in p()) || (p().precio is number && p().precio >= 0 && p().precio <= 100000))
          && (!('url' in p()) || (p().url is string && p().url.size() <= 500 && p().url.matches('^https://.+')))
          && (!('nombre' in p()) || (p().nombre is string && p().nombre.size() <= 40))
          && (!('compania' in p()) || (p().compania is string && p().compania.size() <= 60))
          && (!('horario' in p()) || (p().horario is string && p().horario.size() <= 120))
          && (!('oferta' in p()) || (p().oferta is string && p().oferta.size() <= 120))
          && (!('iata' in p()) || (p().iata is string && p().iata.size() <= 8))
          && (!('origen' in p()) || (p().origen is string && p().origen.size() <= 8))
          && (!('pais' in p()) || (p().pais is string && p().pais.size() <= 60))
          && (!('foto' in p()) || (p().foto is string && p().foto.size() <= 500 && p().foto.matches('^https://.+')))
          && (!('cama' in p()) || (p().cama is string && p().cama.size() <= 120))
          && (!('cama_url' in p()) || (p().cama_url is string && p().cama_url.size() <= 500 && p().cama_url.matches('^https://.+')))
          && (!('cama_precio' in p()) || (p().cama_precio is number && p().cama_precio >= 0 && p().cama_precio <= 100000));
        // Votar: cada cual su voto (sí, quizá o no), o quitarlo.
        allow update: if miembro(hopId)
          && p().diff(resource.data).affectedKeys().hasOnly(['votos'])
          && p().votos.diff(resource.data.votos).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in p().votos) || p().votos[request.auth.uid] in ['si', 'quiza', 'no']);
        allow delete: if entra()
          && (resource.data.autor == request.auth.uid || hop(hopId).creador == request.auth.uid);
      }

      match /mensajes/{mid} {
        allow read: if miembro(hopId);
        allow create: if miembro(hopId)
          && request.resource.data.keys().hasOnly(['autor', 'nombre', 'texto', 'creado'])
          && request.resource.data.keys().hasAll(['autor', 'nombre', 'texto', 'creado'])
          && request.resource.data.autor == request.auth.uid
          && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 40
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
          && request.resource.data.creado == request.time;
        allow delete: if entra()
          && (resource.data.autor == request.auth.uid || hop(hopId).creador == request.auth.uid);
      }
    }

    // El HOP activo de una cuenta premium. Va con el HOP, en la misma escritura,
    // y solo se suelta cuando el HOP ya no existe.
    match /hop_slots/{uid} {
      allow get: if entra() && request.auth.uid == uid;
      allow create: if entra() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hop'])
        && request.resource.data.hop is string
        && getAfter(/databases/$(database)/documents/hops/$(request.resource.data.hop)).data.creador == uid;
      allow delete: if entra() && request.auth.uid == uid
        && !existsAfter(/databases/$(database)/documents/hops/$(resource.data.hop));
    }

    match /encargos/{id} {
      // Pedir algo a un scraper: cuentas aprobadas (premium cuando se exija,
      // ver arriba), a su nombre, y con las mismas diez propiedades como mucho
      // que admite GitHub en un dispatch.
      allow create: if aprobado()
        && request.resource.data.keys().hasOnly(['tipo', 'owner', 'payload', 'estado', 'creado'])
        && request.resource.data.keys().hasAll(['tipo', 'owner', 'payload', 'estado', 'creado'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creado == request.time
        && request.resource.data.tipo in ['search', 'stay', 'interrail', 'watch', 'unwatch', 'delete_search']
        && request.resource.data.payload is map
        && request.resource.data.payload.size() <= 10
        // El Interrail a medida (`ruta: tuya`) es premium; las rutas hechas, no.
        && (request.resource.data.tipo != 'interrail'
          || request.resource.data.payload.get('ruta', '') != 'tuya'
          || premium());

      // Ver cómo van los tuyos. Las consultas tienen que filtrar por `owner`.
      allow get, list: if entra() && (resource.data.owner == request.auth.uid || admin());
    }
  }
}
