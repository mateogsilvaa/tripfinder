{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2022": true
  },
  "globals": {
    "TF_FREQ_CHOLLOS": "readonly",
    "TF_FREQ_SEGUIMIENTOS": "readonly",
    "TF_REPO": "readonly",
    "TF_SESION_KEY": "readonly",
    "nubeActiva": "readonly",
    "nubeCambiarClave": "readonly",
    "nubeCambiarEstado": "readonly",
    "nubeCuentas": "readonly",
    "nubeCuentasAntiguas": "readonly",
    "nubeEncargar": "readonly",
    "nubeEntrar": "readonly",
    "nubeGuardarPerfil": "readonly",
    "nubeMisEncargos": "readonly",
    "nubeOlvide": "readonly",
    "nubeReenviarVerificacion": "readonly",
    "nubeRegistrar": "readonly",
    "nubeSalir": "readonly",
    "nubeSincronizar": "readonly",
    "nubeToken": "readonly",
    "nubeTokens": "readonly",
    "nubeVincular": "readonly",
    "tfAbrirBuzon": "readonly",
    "tfAbrirDialogo": "readonly",
    "tfAbrirLogin": "readonly",
    "tfAbrirSellado": "readonly",
    "tfAbrirSobre": "readonly",
    "tfAdoptarAnonimos": "readonly",
    "tfAnunciar": "readonly",
    "tfApuntar": "readonly",
    "tfCampoClave": "readonly",
    "tfCerrarBuzon": "readonly",
    "tfCerrarDialogo": "readonly",
    "tfCerrarModal": "readonly",
    "tfCerrarToken": "readonly",
    "tfClave": "readonly",
    "tfClaveDe": "readonly",
    "tfCryptoOK": "readonly",
    "tfDispatch": "readonly",
    "tfEntrar": "readonly",
    "tfEsDeLaCaja": "readonly",
    "tfEsc": "readonly",
    "tfHacerSobre": "readonly",
    "tfHayDialogo": "readonly",
    "tfLeerUsuarios": "readonly",
    "tfLog": "readonly",
    "tfMarcarCaja": "readonly",
    "tfModal": "readonly",
    "tfNombre": "readonly",
    "tfNuevaMaestra": "readonly",
    "tfNuevoBuzon": "readonly",
    "tfOcupado": "readonly",
    "tfOlvidarAnuncio": "readonly",
    "tfOpciones": "readonly",
    "tfProbarToken": "readonly",
    "tfSalir": "readonly",
    "tfSellar": "readonly",
    "tfSesion": "readonly",
    "tfToken": "readonly",
    "tfUid": "readonly",
    "tfUids": "readonly",
    "tfVaciarLog": "readonly",
    "tfWireVerClave": "readonly"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^(tf|TF_|nube|NUBE_)",
        "caughtErrors": "all"
      }
    ],
    "no-undef": "error",
    "no-func-assign": "error"
  },
  "ignorePatterns": [
    "partes/**"
  ]
}
